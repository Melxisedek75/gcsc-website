# ══════════════════════════════════════════
# GCSC Agent Kit — Environment Variables
# Скопируй этот файл в .env и заполни ключи
# cp .env.example .env
# ══════════════════════════════════════════

# ── Anthropic (обязательно) ───────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram Bot ─────────────────────────
# Получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456789:AAF...
# Твой Telegram User ID (узнать у @userinfobot)
TELEGRAM_ADMIN_ID=123456789

# ── XPR Network ──────────────────────────
XPR_PRIVATE_KEY=PVT_K1_...
XPR_ACCOUNT=youraccount

# ── Real Estate APIs ─────────────────────
# Zillow: https://www.zillow.com/howto/api/APIOverview.htm
ZILLOW_API_KEY=your_zillow_key
# ATTOM: https://api.developer.attomdata.com
ATTOM_API_KEY=your_attom_key

# ── KYC/AML (опционально для старта) ─────
# Sumsub: https://sumsub.com
SUMSUB_API_KEY=your_sumsub_key
SUMSUB_SECRET_KEY=your_sumsub_secret

# ── Metal Blockchain (опционально) ───────
METAL_API_KEY=your_metal_key

# ── Web UI ────────────────────────────────
PORT=4632
