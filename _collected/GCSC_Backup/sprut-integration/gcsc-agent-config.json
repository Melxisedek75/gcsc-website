{
  "agent": {
    "name": "GCSC Agent",
    "version": "1.0.0",
    "model": "claude-opus-4-6",
    "soul": "./SOUL.md",
    "rules": "./AGENTS.md"
  },
  "llm": {
    "model": "claude-opus-4-6",
    "maxTokens": 8192,
    "temperature": {
      "default": 0.3,
      "matching": 0.1,
      "creative": 0.7,
      "compliance": 0.0
    }
  },
  "memory": {
    "enabled": true,
    "dbPath": "./gcsc-memory.sqlite",
    "maxResults": 10,
    "vectorWeight": 0.7,
    "textWeight": 0.3,
    "decay": {
      "semantic": -0.01,
      "episodic": -0.05,
      "contractorScore": -0.02
    },
    "expiry": {
      "propertyValuation": 7776000,
      "contractorMatch": 2592000,
      "kycVerification": 31536000
    }
  },
  "agents": {
    "CMA": {
      "name": "Contractor Matching Agent",
      "skill": "./gcsc-skills/skill-cma.md",
      "timeout": 30000,
      "maxMatches": 5,
      "minScore": 0.65,
      "cache": { "enabled": true, "ttl": 3600 }
    },
    "RAA": {
      "name": "Risk Assessment Agent",
      "skill": "./gcsc-skills/skill-raa.md",
      "timeout": 20000,
      "autoBlockThreshold": 80,
      "alertThreshold": 60,
      "monitorInterval": 3600
    },
    "CA": {
      "name": "Compliance Agent",
      "skill": "./gcsc-skills/skill-ca.md",
      "timeout": 45000,
      "kycRequired": true,
      "licenseCheckStates": ["WA","CA","TX","FL","NY"],
      "amlProviders": ["ofac","un","eu","uk"]
    },
    "TA": {
      "name": "Treasury Agent",
      "skill": "./gcsc-skills/skill-ta.md",
      "timeout": 15000,
      "maxAutoRelease": 50000,
      "requireConfirmationAbove": 50000,
      "escrowMilestones": [0.20, 0.30, 0.30, 0.20]
    },
    "REA": {
      "name": "Real Estate Agent",
      "skill": "./gcsc-skills/skill-rea.md",
      "timeout": 30000,
      "valuationSources": ["zillow","attom","redfin"],
      "updateInterval": 7776000,
      "maxLTV": 0.70,
      "collateralFactor": 0.65
    }
  },
  "blockchain": {
    "network": "xpr-network",
    "rpcEndpoint": "https://proton.greymass.com",
    "chainId": "384da888112027f0321850a169f737c33e53e3f23f6aa36e3d6588e65fe7ef1",
    "contracts": {
      "token": "gcsctoken111",
      "member": "gcscmember11",
      "lead": "gcsclead1111",
      "stake": "gcscstake111",
      "treasury": "gcsctreasry1",
      "realty": "gcscrealty11",
      "insurance": "gcscinsure11"
    },
    "tokens": {
      "GCSC": { "contract": "gcsctoken111", "precision": 4 },
      "GCST": { "contract": "gcsctoken111", "precision": 2, "peg": "USD" },
      "HET": { "contract": "gcscrealty11", "precision": 2, "peg": "USD" }
    }
  },
  "protonLoan": {
    "endpoint": "https://loan.proton.org",
    "collaterals": ["BTC","ETH","USDC","XPR","XRP","HET"],
    "defaultLTV": 0.70,
    "liquidationThreshold": 0.85,
    "stablecoin": "USDC"
  },
  "telegram": {
    "enabled": true,
    "token": "${TELEGRAM_BOT_TOKEN}",
    "allowedUserIds": ["${TELEGRAM_ADMIN_ID}"],
    "commands": {
      "/match": "Find contractors for a project",
      "/assess": "Run risk assessment",
      "/value": "Get property valuation",
      "/status": "Check project status",
      "/escrow": "View escrow balance",
      "/help": "Show all commands"
    }
  },
  "web": {
    "enabled": true,
    "port": 4632,
    "cors": ["http://localhost:3000", "https://melxisedek75.github.io"]
  },
  "api": {
    "baseUrl": "http://localhost:4632",
    "endpoints": {
      "runAgent": "POST /api/subagent/run",
      "agentStatus": "GET /api/subagent/status/:id",
      "waitResult": "GET /api/subagent/wait/:id",
      "matchContractor": "POST /api/gcsc/match",
      "assessRisk": "POST /api/gcsc/assess",
      "valueProperty": "POST /api/gcsc/value",
      "releaseEscrow": "POST /api/gcsc/escrow/release"
    }
  },
  "security": {
    "level": "strict",
    "maxTransactionAuto": 50000,
    "requireMFA": true,
    "kycRequired": true,
    "rateLimit": {
      "matchRequests": "10/hour",
      "valuationRequests": "5/hour",
      "escrowReleases": "3/hour"
    }
  },
  "logging": {
    "level": "info",
    "file": "./logs/gcsc-agent.log",
    "onChainAudit": true
  }
}
