{
  "expo": {
    "name": "SmartContractor",
    "slug": "smartcontractor",
    "scheme": "smartcontractor",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gcsc.smartcontractor",
      "associatedDomains": ["applinks:smartcontractor.gcsc.io"]
    },
    "android": {
      "package": "com.gcsc.smartcontractor",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [{ "scheme": "smartcontractor", "host": "webauth-callback" }]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
