# Server
PORT=3001
PUBLIC_SITE_URL=https://xprnet.org
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://xprnet.org,https://www.xprnet.org
ALLOWED_AUTH_REDIRECT_ORIGINS=http://localhost:3002,https://xprnet.org,https://www.xprnet.org

# AI provider.
# Current server uses the OpenAI SDK against OpenRouter, so this value should be an OpenRouter API key.
ANTHROPIC_API_KEY=your_openrouter_api_key_here

# Supabase public project config. Keep service-role keys out of this app unless server-only auth is added.
SUPABASE_URL=https://uhixuyurxsrxayhghjzm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_yniwnhi_me7Y53Gj7NPJvw_wSCN60C_
# Server-side only. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here
# Founder decision. Recommended MVP value: magic_link. Alternative: password.
SMARTCONTRACTOR_AUTH_MODE=magic_link
# Keep draft for local demo. Set strict before public launch to require Supabase Auth on protected API/routes.
SMARTCONTRACTOR_ROUTE_PROTECTION=draft
SMARTCONTRACTOR_ADMIN_ENFORCEMENT_MODE=draft
# AI recommendation endpoint audit behavior. Keep live outside tests.
# Set SMARTCONTRACTOR_AI_AGENT_AUDIT_MODE=skip only for local smoke tests to avoid writing test rows to live Supabase audit tables.
SMARTCONTRACTOR_AI_AGENT_AUDIT_MODE=live

# Payment providers. Keep all secret keys server-side only.
GCSC_XPR_RECEIVER_ACCOUNT=gcsctoken111
METAL_PAY_CONNECT_API_KEY=your_metal_pay_connect_api_key_here
METAL_PAY_CONNECT_SECRET_KEY=your_metal_pay_connect_secret_key_here
METAL_PAY_CONNECT_ENV=dev
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key_here
BTCPAY_SERVER_URL=https://your-btcpay-server.example
BTCPAY_API_KEY=your_btcpay_api_key_here

# Verification providers. Optional until provider accounts are approved.
PERSONA_API_KEY=your_persona_api_key_here
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
MIDDESK_API_KEY=your_middesk_api_key_here

# Optional integrations.
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here
