{
  "name": "gcsc-construction-ai",
  "version": "1.0.0",
  "description": "GCSC Construction AI — intelligent assistant for contractors and homeowners",
  "main": "server.js",
  "scripts": {
    "check": "npm run check:smartcontractor && npm run check:mobile && npm run check:auth && npm run check:strict-gates && npm run check:rls-draft && npm run check:payment-ownership && npm run check:contract-docs && npm run check:nonstop-hook && npm run check:ci-workflow",
    "check:smartcontractor": "node scripts/validate-smartcontractor.mjs",
    "check:mobile": "node scripts/validate-mobile-readiness.mjs",
    "check:auth": "node scripts/smoke-auth-ownership.mjs",
    "check:strict-gates": "node scripts/smoke-strict-gates.mjs",
    "check:rls-draft": "node scripts/validate-strict-rls-draft.mjs",
    "check:payment-ownership": "node scripts/validate-payment-ownership-draft.mjs",
    "check:contract-docs": "node scripts/validate-smart-contract-design-docs.mjs",
    "check:nonstop-hook": "node scripts/validate-nonstop-hook.mjs",
    "check:ci-workflow": "node scripts/validate-ci-workflow.mjs",
    "test": "npm run check",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.87.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
